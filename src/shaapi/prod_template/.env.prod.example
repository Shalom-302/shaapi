# Production environment for {{cli}} — copy to `.env` ON THE SERVER and fill in.
# The app REFUSES to boot while any secret below is still a placeholder.
#
#   cp .env.prod.example .env
#   {{cli}} ops secrets --write     # fills the secrets/credentials for you
#
ENVIRONMENT=prod

# Use Alembic migrations in production (never auto-create tables).
DB_AUTO_CREATE=false

# --- Database (Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DATABASE=shaapi

# --- Redis ---
REDIS_PASSWORD=

# --- Object storage (MinIO / S3) ---
MINIO_ACCESS_KEY=shaapi
MINIO_SECRET_KEY=CHANGE_ME_strong_minio_secret
MINIO_BUCKET_NAME=shaapi

# --- Secrets ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET_KEY=CHANGE_ME_token_secret
# python -c "import os; print(os.urandom(32).hex())"
OPERA_LOG_ENCRYPT_SECRET_KEY=CHANGE_ME_opera_log_secret

# --- Cookies ---
# secure=true is required outside dev. Use samesite=none ONLY if the front-end
# is on a different site than the API (and then secure MUST stay true).
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- External geo-IP lookup (off) ---
IP_LOCATION_PARSE=false
